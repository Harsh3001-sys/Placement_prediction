# Backend API Base URL
# Local development (uses Vite dev proxy in vite.config.ts):
VITE_API_BASE_URL=/api
# Production (Vercel env var): set to your deployed Render backend URL.
# You may provide either the origin or the /api base; the frontend normalizes to /api.
# Example: VITE_API_BASE_URL=https://placement-prediction-2ebd.onrender.com
# Example: VITE_API_BASE_URL=https://placement-prediction-2ebd.onrender.com/api
